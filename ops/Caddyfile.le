{
	email {$ACME_EMAIL}
}

(site) {
	header {
		-Server
	}

	# Never gzip audio streams — breaks 206 Range / FLAC seeking.
	handle /api/stream/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		encode gzip
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /fonts/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle /assets/* {
		encode zstd gzip
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode gzip
		root * /srv/frontend
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Cloudflare DNS only (grey cloud): trusted HTTPS via Let's Encrypt.
http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$DOMAIN} {
	import site
}
