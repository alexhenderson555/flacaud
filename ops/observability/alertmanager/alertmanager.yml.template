# Rendered into alertmanager.yml at deploy time (see scripts/repair_servers.py
# deploy_tidal_server) by substituting the __PLACEHOLDER__ tokens below with
# real values from the deploying machine's env -- Alertmanager's config
# format has no built-in ${VAR} substitution, and this file is git-tracked,
# so the real Resend API key must never be committed here directly.
global:
  smtp_smarthost: 'smtp.resend.com:587'
  smtp_from: '__GRAFANA_ALERT_FROM__'
  smtp_auth_username: 'resend'
  smtp_auth_password: '__RESEND_API_KEY__'
  smtp_require_tls: true

# Multi-window burn-rate alerts (FlacAudErrorBudgetBurnFast/Slow) already
# encode urgency via severity; group by alertname so a burst of the SAME
# alert across labels (e.g. multiple routes) collapses into one email
# instead of one per label combination.
route:
  receiver: email
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - match:
        severity: critical
      receiver: email
      repeat_interval: 1h
    - match:
        severity: warning
      receiver: email
      repeat_interval: 12h

receivers:
  - name: email
    email_configs:
      - to: '__GRAFANA_ALERT_EMAIL__'
        send_resolved: true
