{
	email {$ACME_EMAIL}
	auto_https disable_redirects
}

(site) {
	header {
		-Server
	}

	handle /api/stream/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		encode gzip
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /fonts/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Same reasoning as /api/stream/* above: never gzip video.
	handle /videos/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle /assets/* {
		encode zstd gzip
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode gzip
		root * /srv/frontend
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

http://{$DOMAIN} {
	import site
}

https://{$DOMAIN} {
	tls internal
	import site
}
