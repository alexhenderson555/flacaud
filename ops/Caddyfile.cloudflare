{
	email {$ACME_EMAIL}
	auto_https disable_redirects
	# Disable HTTP/3 (QUIC/UDP) instance-wide -- suspected cause of direct
	# (non-VPN) loads being slow/flaky for RU visitors: browsers see the h3
	# Alt-Svc header and try QUIC-over-UDP first, which RU ISPs are known to
	# throttle/drop more aggressively than plain TCP+TLS, wasting the QUIC
	# handshake timeout before falling back to h2. This is a listener-level
	# setting (all domains sharing :443 on this Caddy instance get it, since
	# `protocols` isn't a valid per-site directive -- confirmed the hard way:
	# it crash-looped Caddy with "unrecognized directive: protocols" when
	# tried inside a site block).
	servers {
		protocols h1 h2
	}
}

(site) {
	header {
		-Server
	}

	# Caddy only logs errors by default -- successful static file_server
	# requests (all of /assets/*, /videos/*, /fonts/*) leave zero trace,
	# which made a real user-reported "site won't load" impossible to
	# diagnose from server-side logs alone (nothing to show whether their
	# requests ever reached origin, or what happened to them if they did).
	log {
		output stdout
		format json
	}

	handle /api/stream/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		encode gzip
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /fonts/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Same reasoning as /api/stream/* above: never gzip video.
	handle /videos/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle /assets/* {
		encode zstd gzip
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode gzip
		root * /srv/frontend
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

http://{$DOMAIN} {
	import site
}

https://{$DOMAIN} {
	tls internal
	import site
}

# flacaud.com: mirror of flacaud.ru on a domain not (yet) targeted by RU
# ISP-level SNI/DPI blocking of the .ru name, for visitors without a VPN.
http://flacaud.com, http://www.flacaud.com {
	redir https://{host}{uri} permanent
}

https://flacaud.com, https://www.flacaud.com {
	import site
}

# --- Other tenants on this VPS, sharing this one Caddy process -----------
# See the matching comment in ops/Caddyfile.le for the full explanation.
# These get normal automatic (Let's Encrypt) HTTPS, not `tls internal` --
# that override is scoped to the flacaud.ru block above only.

# zapiis (ai-booking-bot): API + landing + audit tool
https://api.zapiis.ru {
	reverse_proxy zapiis-bot:8787 {
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
	}
}

https://zapiis.ru, https://www.zapiis.ru {
	header {
		-Server
	}
	encode gzip
	handle_path /audit/* {
		root * /srv/zapiis-audit
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv/zapiis-landing
		try_files {path} {path}.html
		file_server
	}
}

# kld-events (Nishevy Kaliningrad): events map webapp, proxied to the host
# app on :8080 via the bridge gateway. See ops/Caddyfile.le for details.
https://niche-kld.ru, https://www.niche-kld.ru {
	header {
		-Server
	}
	reverse_proxy 172.18.0.1:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
	}
}
