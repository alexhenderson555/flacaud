{
	email {$ACME_EMAIL}
}

(site) {
	header {
		-Server
	}

	# Caddy only logs errors by default -- successful static file_server
	# requests (all of /assets/*, /videos/*, /fonts/*) leave zero trace,
	# which made a real user-reported "site won't load" impossible to
	# diagnose from server-side logs alone (nothing to show whether their
	# requests ever reached origin, or what happened to them if they did).
	log {
		output stdout
		format json
	}

	# Never gzip audio streams — breaks 206 Range / FLAC seeking.
	handle /api/stream/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		encode gzip
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /fonts/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Same reasoning as /api/stream/* above: never gzip video.
	handle /videos/* {
		root * /srv/frontend
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle /assets/* {
		encode zstd gzip
		root * /srv/frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		encode gzip
		root * /srv/frontend
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Cloudflare DNS only (grey cloud): trusted HTTPS via Let's Encrypt.
http://{$DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$DOMAIN} {
	# Disable HTTP/3 (QUIC/UDP) -- suspected cause of direct (non-VPN) loads
	# being slow/flaky for RU visitors: browsers see our h3 Alt-Svc and try
	# QUIC-over-UDP first, which some RU ISPs throttle/drop far more
	# aggressively than plain TCP+TLS, wasting the QUIC handshake timeout
	# before falling back to h2. TCP-only removes that stall entirely.
	protocols h1 h2
	import site
}

# --- Other tenants on this VPS, sharing this one Caddy process -----------
# These are separate projects (not part of the flacaud deploy) that were
# previously hand-patched directly onto the server's live Caddyfile after
# every deploy overwrote it from this repo -- fragile (undocumented,
# un-reviewable, one `git reset --hard` away from silently vanishing) and
# risky for flacaud itself: a single shared Caddy process means a hung or
# slow upstream on ANY of these can exhaust worker/connection capacity for
# flacaud.ru too, with nothing in flacaud's own logs to explain why. Now
# tracked here as the actual source of truth, with bounded dial/response
# timeouts on each third-party upstream so one tenant hanging can no longer
# starve the others -- flacaud's own reverse_proxy blocks above are left
# untimed since legitimate operations there (DASH remux merge waits, large
# stream reads) can legitimately take longer than a generic third-party
# timeout would allow.

# zapiis (ai-booking-bot): API + landing + audit tool
https://api.zapiis.ru {
	reverse_proxy zapiis-bot:8787 {
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
	}
}

https://zapiis.ru, https://www.zapiis.ru {
	header {
		-Server
	}
	encode gzip
	handle_path /audit/* {
		root * /srv/zapiis-audit
		try_files {path} /index.html
		file_server
	}
	handle {
		root * /srv/zapiis-landing
		try_files {path} {path}.html
		file_server
	}
}

# kld-events (Nishevy Kaliningrad): events map webapp, proxied to the host
# app on :8080 via the bridge gateway (app runs directly on the host, not
# in this compose project's network). Cloudflare is in Full (Strict) mode
# for this domain, so -- unlike the other domains here that sit behind
# Cloudflare Flexible -- this one DOES need its own trusted cert; Caddy gets
# one from Let's Encrypt via HTTP-01 (TLS-ALPN-01 fails since Cloudflare
# terminates the visitor's TLS, that's expected, HTTP-01 still works fine).
https://niche-kld.ru, https://www.niche-kld.ru {
	header {
		-Server
	}
	reverse_proxy 172.18.0.1:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 10s
		}
	}
}
