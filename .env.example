# ── Environment ───────────────────────────────────────────────
TIDALDLRU_ENV=development          # production on server (enforces secrets)
TIDALDLRU_LOG_LEVEL=INFO           # DEBUG for verbose auth/request traces
TIDALDLRU_LOG_FORMAT=text          # json on production (docker logs)
TIDALDLRU_SLOW_REQUEST_MS=2000     # log slow HTTP as WARNING
# TIDALDLRU_LOG_FILE=app.log       # optional file (dev); prod uses docker logs only
API_PORT=8001

# ── Telegram Bot ──────────────────────────────────────────────
TIDALDLRU_BOT_TOKEN=
TIDALDLRU_API_BASE=http://localhost:8000
# Public URL for Telegram ZIP links (production: tidal server only)
TIDALDLRU_PUBLIC_API_BASE=https://proshli.ru

# ── FastAPI / Server ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TIDALDLRU_JWT_SECRET=               # required in production — python -c "import secrets; print(secrets.token_urlsafe(48))"
TIDALDLRU_SIGNING_SECRET=           # required in production
TIDALDLRU_JOBS_DIR=/var/lib/tidal-dl-ru/jobs
TIDALDLRU_DB_PATH=/var/lib/tidal-dl-ru/db/flacaudio.db
# DATABASE_URL=postgresql+psycopg://tidal:pass@postgres:5432/tidaldl

# ── TLS (docker-compose.prod.yml) ────────────────────────────
DOMAIN=proshli.ru
# ACME_EMAIL=you@example.com
# ACME_EMAIL=admin@example.com

# ── Postgres (docker-compose.postgres.yml) ───────────────────
# POSTGRES_PASSWORD=
# POSTGRES_USER=tidal
# POSTGRES_DB=tidaldl

# ── Deploy (scripts/deploy.py — never commit credentials) ─────
DEPLOY_HOST=46.17.102.157
DEPLOY_USER=root
# VPN (Marzban) — separate host, do NOT deploy tidal-dl-ru here
# VPN_HOST=151.243.177.88
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_PATH=/opt/tidal-dl-ru

# ── ARQ Workers ──────────────────────────────────────────────
TIDALDLRU_ARQ_MAX_JOBS=4
TIDALDLRU_FILE_TTL=86400
TIDALDLRU_JOB_TTL=86400

# ── Tidal Account Pool ──────────────────────────────────────
# TIDALDLRU_POOL_KEY=

# ── User Limits ──────────────────────────────────────────────
TIDALDLRU_FREE_LIMIT=3
TIDALDLRU_BASIC_LIMIT=50
TIDALDLRU_PRO_LIMIT=200

TIDALDLRU_LYRICS=true

# ── Optional integrations ────────────────────────────────────
# TIDALDLRU_AUDD_TOKEN=
# TIDALDLRU_DEEPL_KEY=
# TIDALDLRU_YOOKASSA_SHOP_ID=
# TIDALDLRU_YOOKASSA_SECRET_KEY=
# GEMINI_API_KEY=
