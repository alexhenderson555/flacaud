# ── Environment ───────────────────────────────────────────────
TIDALDLRU_ENV=development          # production on server (enforces secrets)
TIDALDLRU_LOG_LEVEL=INFO           # DEBUG for verbose auth/request traces
TIDALDLRU_LOG_FORMAT=text          # json on production (docker logs)
TIDALDLRU_SLOW_REQUEST_MS=2000     # log slow HTTP as WARNING
# TIDALDLRU_LOG_FILE=app.log       # optional file (dev); prod uses docker logs only
API_PORT=8001

# ── Telegram Bot ──────────────────────────────────────────────
TIDALDLRU_BOT_TOKEN=
TIDALDLRU_API_BASE=http://localhost:8000
# Public URL for Telegram ZIP links (production: tidal server only)
TIDALDLRU_PUBLIC_API_BASE=https://flacaud.ru

# ── FastAPI / Server ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TIDALDLRU_JWT_SECRET=               # required in production — python -c "import secrets; print(secrets.token_urlsafe(48))"
TIDALDLRU_SIGNING_SECRET=           # required in production
TIDALDLRU_JOBS_DIR=/var/lib/tidal-dl-ru/jobs
TIDALDLRU_DB_PATH=/var/lib/tidal-dl-ru/db/flacaudio.db
# TIDAL_USE_POSTGRES=1
# DATABASE_URL=postgresql+psycopg://tidal:pass@postgres:5432/tidaldl

# ── TLS (docker-compose.prod.yml) ────────────────────────────
DOMAIN=flacaud.ru
# ACME_EMAIL=you@example.com
# ACME_EMAIL=admin@example.com

# ── Postgres (docker-compose.postgres.yml) ───────────────────
# POSTGRES_PASSWORD=
# POSTGRES_USER=tidal
# POSTGRES_DB=tidaldl

# ── Deploy (scripts/deploy.py — never commit credentials) ─────
DEPLOY_HOST=your.server.example
DEPLOY_USER=root
# DEPLOY_MODE=registry|tar   (auto: registry if Docker Hub creds set, else tar)
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# FLACAUD_IMAGE_NAMESPACE=flacaud
# FLACAUD_TAG=latest
# FLACAUD_API_IMAGE=flacaud/flacaud-api
# FLACAUD_WORKER_IMAGE=flacaud/flacaud-worker
# FLACAUD_BOT_IMAGE=flacaud/flacaud-bot
# scripts/deploy_tidal.py, verify_prod_health.py (copy to local .env only)
# TIDAL_HOST=your.server.example
# TIDAL_SSH_USER=root
# TIDAL_SSH_PASSWORD=
# VPN (Marzban) — separate host, do NOT deploy tidal-dl-ru here
# VPN_HOST=your.vpn.server.example
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_PATH=/opt/tidal-dl-ru

# ── ARQ Workers ──────────────────────────────────────────────
TIDALDLRU_ARQ_MAX_JOBS=4
TIDALDLRU_FILE_TTL=86400
TIDALDLRU_JOB_TTL=86400
TIDALDLRU_STREAM_CACHE_MAX_BYTES=8589934592
TIDALDLRU_ACCESS_TOKEN_MINUTES=1440
TIDALDLRU_OPS_API_KEY=
TIDALDLRU_FORWARDED_ALLOW_IPS=172.16.0.0/12,127.0.0.1,10.0.0.0/8

# ── Tidal Account Pool ──────────────────────────────────────
# TIDALDLRU_POOL_KEY=

# ── User Limits ──────────────────────────────────────────────
TIDALDLRU_FREE_LIMIT=3
TIDALDLRU_BASIC_LIMIT=50
TIDALDLRU_PRO_LIMIT=200

TIDALDLRU_LYRICS=true

# ── Optional integrations ────────────────────────────────────
# Spotify Web API (Library Transfer — playlists/albums). Dashboard: https://developer.spotify.com/dashboard
# SPOTIPY_CLIENT_ID=
# SPOTIPY_CLIENT_SECRET=
# TIDALDLRU_AUDD_TOKEN=
# TIDALDLRU_DEEPL_KEY=
# TIDALDLRU_YOOKASSA_SHOP_ID=
# TIDALDLRU_YOOKASSA_SECRET_KEY=
# GEMINI_API_KEY=
# Artist portraits: Wikipedia + Deezer + iTunes (no keys). Optional cache TTL (default 7d):
# TIDALDLRU_ARTIST_IMAGE_CACHE_TTL=604800

# ── Outbound email (password reset) ─────────────────────────
# Option A — Resend (recommended): https://resend.com → API Keys + verify flacaud.ru domain
# RESEND_API_KEY=re_xxxxxxxx
# TIDALDLRU_EMAIL_FROM=FlacAud <noreply@flacaud.ru>
#
# Option B — SMTP (Brevo, Mailgun, host mailbox, etc.)
# TIDALDLRU_SMTP_HOST=smtp-relay.brevo.com
# TIDALDLRU_SMTP_PORT=587
# TIDALDLRU_SMTP_USER=
# TIDALDLRU_SMTP_PASSWORD=
# TIDALDLRU_SMTP_FROM=FlacAud <noreply@flacaud.ru>
# TIDALDLRU_SMTP_TLS=true
# Comma-separated model ids (first that responds wins). Default: 2.5-flash-lite, 2.0-flash, 2.5-flash
# TIDALDLRU_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
