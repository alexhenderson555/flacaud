# ── Telegram Bot ──────────────────────────────────────────────
TIDALDLRU_BOT_TOKEN=           # from @BotFather
TIDALDLRU_API_BASE=http://localhost:8000

# ── FastAPI / Server ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TIDALDLRU_SIGNING_SECRET=change-me-in-production
TIDALDLRU_JOBS_DIR=/var/lib/tidal-dl-ru/jobs
TIDALDLRU_FILE_TTL=86400       # signed file URL TTL (seconds)
TIDALDLRU_JOB_TTL=86400        # job record TTL in Redis

# ── ARQ Workers ──────────────────────────────────────────────
TIDALDLRU_ARQ_MAX_JOBS=4

# ── Tidal Auth (override if credentials rotate) ─────────────
# TIDALDLRU_PKCE_CLIENT_ID=6BDSRdpK9hqEBTgU
# TIDALDLRU_PKCE_CLIENT_SECRET=xeuPmY7nbpZ9IIbLAcQ93shka1VNheUAqN6IcszjTG8=
# TIDALDLRU_TV_CLIENT_ID=fX2JxdmntZWK0ixT
# TIDALDLRU_TV_CLIENT_SECRET=1Nn9AfDAjxrgJFJbKNWLeAyKGVGmINuXPPLHVXAvxAg==

# ── Tidal Account Pool ──────────────────────────────────────
# TIDALDLRU_POOL_KEY=           # Fernet key for encrypting refresh tokens

# ── User Limits ──────────────────────────────────────────────
TIDALDLRU_FREE_LIMIT=3         # tracks/day for free users
TIDALDLRU_BASIC_LIMIT=50       # tracks/day for Basic plan
TIDALDLRU_PRO_LIMIT=200        # tracks/day for Pro plan

# ── Lyrics ───────────────────────────────────────────────────
TIDALDLRU_LYRICS=true

# ── Audio Recognition (Shazam mode) ────────────────────────
# TIDALDLRU_AUDD_TOKEN=          # from https://audd.io/

# ── Karaoke (Russian lyrics translation) ───────────────────
# TIDALDLRU_DEEPL_KEY=            # from https://www.deepl.com/pro-api
# TIDALDLRU_DEEPL_API=https://api-free.deepl.com/v2  # or https://api.deepl.com/v2 for Pro

# ── YooKassa (payments) ────────────────────────────────────
# TIDALDLRU_YOOKASSA_SHOP_ID=
# TIDALDLRU_YOOKASSA_SECRET_KEY=
