FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project --no-dev

COPY src ./src
RUN uv sync --no-dev


FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY alembic.ini /app/alembic.ini
COPY migrations /app/migrations
COPY scripts /app/scripts
COPY frontend /app/frontend

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    TIDALDLRU_ENV=production

RUN mkdir -p /var/lib/tidal-dl-ru/jobs /root/.config/tidal-dl-ru /var/lib/tidal-dl-ru/db

EXPOSE 8000
ENV TIDALDLRU_FORWARDED_ALLOW_IPS="172.16.0.0/12,127.0.0.1,10.0.0.0/8"
CMD ["sh", "-c", "exec uvicorn tidal_dl_ru.server.app:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips \"${TIDALDLRU_FORWARDED_ALLOW_IPS}\""]
