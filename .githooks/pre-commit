#!/usr/bin/env bash
# Block commits that fail lint, so the gates stop rotting between sessions.
# Install once:  git config core.hooksPath .githooks   (or: make hooks)
# Bypass a single commit with:  git commit --no-verify
set -u
root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACM)"
fail=0

if printf '%s\n' "$staged" | grep -qE '\.py$'; then
  echo "[pre-commit] ruff…"
  (cd "$root" && uv run ruff check src tests scripts) || fail=1
fi

if printf '%s\n' "$staged" | grep -qE '^frontend/.*\.(js|jsx)$'; then
  echo "[pre-commit] eslint…"
  (cd "$root/frontend" && npx eslint .) || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-commit] BLOCKED — fix the lint above (or 'git commit --no-verify' to bypass)."
  exit 1
fi
